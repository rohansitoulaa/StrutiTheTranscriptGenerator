{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shruti",
  "version": "0.1.0",
  "identifier": "app.shruti.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shruti",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "externalBin": [
      "binaries/shruti-whisper-cli",
      "binaries/shruti-yt-dlp"
    ],
    "shortDescription": "Links to clean Obsidian notes",
    "linux": {
      "rpm": {
        "depends": [
          "/usr/bin/ffmpeg",
          "/usr/bin/node",
          "vulkan-loader",
          "libgomp"
        ]
      }
    }
  }
}
